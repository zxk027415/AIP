# 后端配置示例
PORT=8080
HOST=0.0.0.0
DEBUG=True
CORS_ORIGINS=http://localhost:3000

# @AI_GENERATED
# ==== 数据库连接（MySQL）====
# 加载优先级：环境变量 > backend-service/configs/db.yaml > 代码默认值
# 实际由 services/db/config.py::DBConfig 读取；未列出的变量含义见该文件。
#
# 用法建议：
#   - 生产 / 开发环境只需设置 DB_CONNECTION_URL 一个变量即可完成连接配置；
#   - DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME 供人工组装 URL 时参考，
#     当前实现不会单独读取它们，若同时提供也不会自动合成到 DB_CONNECTION_URL。

# DB_CONNECTION_URL — 完整数据库连接字符串（推荐仅用此变量，最高优先级）
# 格式：mysql+pymysql://<user>:<password>@<host>:<port>/<database>
# 默认：mysql+pymysql://root@localhost:3306/aip_algo_platform
DB_CONNECTION_URL=mysql+pymysql://root:<your_password>@localhost:3306/aip_algo_platform

# DB_ENGINE — 数据库引擎类型；当前仅支持 mysql，默认 mysql
DB_ENGINE=mysql

# DB_HOST — 数据库主机地址（用于人工拼接 DB_CONNECTION_URL），默认 localhost
DB_HOST=localhost

# DB_PORT — 数据库端口号（用于人工拼接 DB_CONNECTION_URL），默认 3306
DB_PORT=3306

# DB_USER — 数据库用户名（用于人工拼接 DB_CONNECTION_URL），默认 root
DB_USER=root

# DB_PASSWORD — 数据库密码（用于人工拼接 DB_CONNECTION_URL），示例请替换为真实值
# 不要把真实密码提交到仓库，请在本地 .env / 部署环境注入
DB_PASSWORD=<your_password>

# DB_NAME — 数据库名称（用于人工拼接 DB_CONNECTION_URL），默认 aip_algo_platform
DB_NAME=aip_algo_platform

# DB_POOL_MAX — 连接池最大连接数，范围 [1, 100]，默认 10
DB_POOL_MAX=10

# DB_ENABLED — 数据库总开关；false 时退化到纯文件存储（不做 MySQL 连接）
# 允许值：1/true/yes/on 视为 true；其他视为 false；默认 true
DB_ENABLED=true
# @AI_GENERATED: end
