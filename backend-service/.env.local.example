# Local-only overrides (DO NOT COMMIT real secrets)
#
# Copy to `.env.local` and fill in values:
#   cp .env.local.example .env.local
#
# Then load into your current shell:
#   source ./scripts/load_glm_env.sh

# Required for GLM calls (keep it ONLY in `.env.local`, never in git)
GLM_API_KEY=

# Optional
GLM_ENABLE=true
GLM_RESEARCH_QUESTIONS_ENABLE=true
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
GLM_MODEL=glm-5.1
GLM_TIMEOUT_S=120
