    # @AI_GENERATED: 启动时打印所有参数，方便调试确认
    print("\n" + "=" * 60)
    print("  [AutoResearch] 启动参数汇总")
    print("=" * 60)
    print(f"  baseline_workflow_id: {baseline_id}")
    print(f"  windows ({len(windows)} 个):")
    for w in windows:
        print(f"    {w.get('start_date', '?')} ~ {w.get('end_date', '?')}")
