def _verify_hypothesis(iteration_result: Dict[str, Any], last_proposal: Optional[Dict[str, Any]]) -> Optional[Dict[str, Any]]:
    """
    任务 21.1：验证上一轮假设是否成立。

    Args:
        iteration_result（本轮迭代结果）: all_candidates 中的一条记录
        last_proposal（上一轮 proposal）: _auto_research_proposals_store 中的 proposal 对象

    Returns:
        {
            "hypothesis": str,                  # 假设文本
            "verified": bool,                   # 是否成立
            "expected_threshold": float | None, # 预期阈值
            "actual_improvement": float | None, # 实际改善量
            "conclusion": str,                  # 验证结论（人类可读）
        }
        若 last_proposal 无 expected_outcome，返回 None
    """
    if not isinstance(last_proposal, dict):
        return None
    expected_outcome = last_proposal.get("expected_outcome")
    if not isinstance(expected_outcome, dict):
        return None

    hypothesis = str(last_proposal.get("hypothesis") or "")
    metric = str(expected_outcome.get("metric") or "mape_improvement")
    direction = str(expected_outcome.get("direction") or "increase")
    threshold = expected_outcome.get("threshold")

    # 从迭代结果中读取对应指标
    ev = iteration_result.get("evaluation") or {}
    actual_val: Optional[float] = None
    if metric == "mape_improvement":
        actual_val = ev.get("mape_improvement")
    elif metric == "challenger_mape":
        actual_val = ev.get("challenger_mape")
    elif metric == "score_advantage":
        actual_val = ev.get("score_advantage")
    else:
        actual_val = ev.get(metric)

    try:
        actual_float = float(actual_val) if actual_val is not None else None
        threshold_float = float(threshold) if threshold is not None else None
    except (TypeError, ValueError):
        actual_float = None
        threshold_float = None

    # 判定是否成立
    verified = False
    if actual_float is not None and threshold_float is not None:
        if direction == "increase":
            verified = actual_float >= threshold_float
        elif direction == "decrease":
            verified = actual_float <= threshold_float
        else:
            verified = abs(actual_float) >= abs(threshold_float)

    actual_str = f"{actual_float:.4f}" if actual_float is not None else "N/A"
    conclusion = (
        f"✓ 成立：{metric}={actual_str}，达到预期阈值 {threshold_float}"
        if verified else
        f"✗ 未成立：{metric}={actual_str}，未达到预期阈值 {threshold_float}"
    )

    return {
        "hypothesis": hypothesis,
        "verified": verified,
        "expected_threshold": threshold_float,
        "actual_improvement": actual_float,
        "conclusion": conclusion,
    }


def _update_hypothesis_state(
    run_state: Dict[str, Any],
    iteration: int,
    verification: Optional[Dict[str, Any]],
) -> None:
    """
    任务 21.3 + 21.4：维护已否证假设集和累积洞察。

    Args:
        run_state（运行状态）: _auto_research_store[run_id]
        iteration（当前轮次）: 迭代编号
        verification（假设验证结果）: _verify_hypothesis 的返回值
    """
    if not isinstance(verification, dict):
        return

    # 初始化 insights 结构
    if not isinstance(run_state.get("insights"), dict):
        run_state["insights"] = {
            "effective_directions": [],       # 已验证有效的方向
            "ineffective_directions": [],     # 已验证无效的方向
            "total_hypotheses_tested": 0,     # 已测试假设总数
            "hypotheses_verified": 0,         # 成立的假设数
            "hypotheses_disproved": 0,        # 否证的假设数
        }
    if not isinstance(run_state.get("disproved_hypotheses"), list):
        run_state["disproved_hypotheses"] = []

    insights = run_state["insights"]
    hypothesis = str(verification.get("hypothesis") or "")
    verified = bool(verification.get("verified"))
    actual = verification.get("actual_improvement")
    insights["total_hypotheses_tested"] = int(insights.get("total_hypotheses_tested") or 0) + 1

    if verified:
        insights["hypotheses_verified"] = int(insights.get("hypotheses_verified") or 0) + 1
        improvement_pct = f"{float(actual) * 100:.2f}%" if actual is not None else "?"
        entry = f"{hypothesis}（第{iteration}轮验证，改善{improvement_pct}）"
        eff = insights.get("effective_directions") or []
        eff.append(entry)
        insights["effective_directions"] = eff[-10:]  # 最多保留 10 条
    else:
        insights["hypotheses_disproved"] = int(insights.get("hypotheses_disproved") or 0) + 1
        entry = f"{hypothesis}（第{iteration}轮否证，实际={actual}）"
        ineff = insights.get("ineffective_directions") or []
        ineff.append(entry)
        insights["ineffective_directions"] = ineff[-10:]

        # 追加到已否证假设集（FIFO，最多 20 条）
        # 保存 patch 指纹用于去重（按实际改动内容匹配，不靠文本）
        disproved = run_state["disproved_hypotheses"]
        _last_prop = run_state.get("last_applied_proposal") or {}
        _patch_fingerprint = _build_patch_fingerprint(_last_prop)
        disproved.append({
            "hypothesis": hypothesis,
            "iteration": iteration,
            "actual_result": actual,
            "disproved_at": datetime.now().isoformat(),
            "patch_fingerprint": _patch_fingerprint,
        })
        run_state["disproved_hypotheses"] = disproved[-20:]


def _build_patch_fingerprint(proposal: Dict[str, Any]) -> str:
    """
    从 proposal 的实际改动内容生成指纹字符串，用于去重。
    只看 structure_patch 的 node_switches（functionId + enabled）和 node_param_patches（functionId + param_key）。
    不看文本假设，只看"实际改了什么"。
    """
    parts: List[str] = []
    sp = proposal.get("structure_patch") or {}
    switches = sp.get("node_switches") if isinstance(sp, dict) else None
    if isinstance(switches, list):
        for sw in sorted(switches, key=lambda x: str(x.get("functionId", ""))):
            if isinstance(sw, dict):
                fid = str(sw.get("functionId") or "")
                enabled = sw.get("enabled")
                if fid:
                    parts.append(f"sw:{fid}={enabled}")
    npp = proposal.get("node_param_patches")
    if isinstance(npp, list):
        for p in sorted(npp, key=lambda x: str(x.get("functionId", ""))):
            if isinstance(p, dict):
                fid = str(p.get("functionId") or "")
                pk = p.get("param_patch") or {}
                if fid and pk:
                    parts.append(f"np:{fid}:{sorted(pk.keys())}")
    gcp = proposal.get("global_config_patch")
    if isinstance(gcp, dict) and gcp:
        parts.append(f"gc:{sorted(gcp.keys())}")
    return "|".join(parts) if parts else ""


def _is_parameter_saturated(iterations: List[dict], k: int = 4, threshold: float = 0.05) -> bool:
    """
    检测参数层是否已饱和：取最近 k 轮 status == "success" 的迭代，
    若全部 mape_improvement < threshold 则返回 True。
    成功轮少于 k 轮时返回 False（数据不足，不触发饱和）。

    Args:
        iterations: run_state["iterations"] 列表
        k: 连续成功轮数阈值，默认 4
        threshold: mape_improvement 改善阈值，默认 0.05

    Returns:
        True 表示参数层已饱和，False 表示未饱和或数据不足
    """
    success_iters = [
        it for it in (iterations or [])
        if isinstance(it, dict) and str(it.get("status")) == "success"
    ]
    recent = success_iters[-k:]
    if len(recent) < k:
        return False
    for it in recent:
        ev = it.get("evaluation") or {}
        mi = ev.get("mape_improvement")
        if mi is None:
            return False
        try:
            if float(mi) >= threshold:
                return False
        except (TypeError, ValueError):
            return False
    return True


def _compute_diff_from_baseline(
    baseline_wf: dict,
    challenger_override: Optional[dict],
    structure_patch: Optional[dict],
    parameter_patch: Optional[dict],
) -> dict:
    """
    计算 Challenger 相对 Baseline 的配置差异
    
    Args:
        baseline_wf: Baseline 工作流模板对象
        challenger_override: challenger_config_override（评测量约层覆盖）
        structure_patch: challenger_structure_override（结构层补丁）
        parameter_patch: challenger_global_config_patch（全局配置补丁）
    
    Returns:
        {
            "added_keys": [...],  # 新增的键
            "changed_keys": [{"key": str, "baseline": Any, "challenger": Any}],  # 变更的键
            "removed_keys": [...]  # 移除的键（通常为空，因为是补丁模式）
        }
    """
    added_keys = []
    changed_keys = []
    removed_keys = []

    # Pydantic 模型对象转 dict，避免 .get() AttributeError
    if hasattr(baseline_wf, 'dict'):
        baseline_wf = baseline_wf.dict()
    if not isinstance(baseline_wf, dict):
        baseline_wf = {}

    # 1. 处理 config_override（评测量约层）
    if isinstance(challenger_override, dict):
        for key, challenger_val in challenger_override.items():
            baseline_val = baseline_wf.get(key)
            if baseline_val is None:
                added_keys.append(f"config.{key}")
            elif baseline_val != challenger_val:
                changed_keys.append({
                    "key": f"config.{key}",
                    "baseline": baseline_val,
                    "challenger": challenger_val,
                })
    
    # 2. 处理 structure_patch（结构层）
    if isinstance(structure_patch, dict):
        for key, challenger_val in structure_patch.items():
            baseline_val = baseline_wf.get(key)
            if baseline_val is None:
                added_keys.append(f"structure.{key}")
            elif baseline_val != challenger_val:
                changed_keys.append({
                    "key": f"structure.{key}",
                    "baseline": baseline_val,
                    "challenger": challenger_val,
                })
    
    # 3. 处理 parameter_patch（全局配置层）
    if isinstance(parameter_patch, dict):
        baseline_global = baseline_wf.get("global_config") or {}
        for key, challenger_val in parameter_patch.items():
            baseline_val = baseline_global.get(key)
            if baseline_val is None:
                added_keys.append(f"global_config.{key}")
            elif baseline_val != challenger_val:
                changed_keys.append({
                    "key": f"global_config.{key}",
                    "baseline": baseline_val,
                    "challenger": challenger_val,
                })
    
    return {
        "added_keys": added_keys,
        "changed_keys": changed_keys,
        "removed_keys": removed_keys,
    }


