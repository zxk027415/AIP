    validation = _validate_proposal_patch(proposal, baseline_workflow_id=baseline_wf or None)
    if not validation.get("valid"):
        proposal["validation"] = validation
        _auto_research_proposals_store[proposal_id] = proposal
        raise HTTPException(status_code=400, detail={"message": "建议草案校验失败", "errors": validation.get("errors")})
    runtime_patch = state.get("runtime_patch") or {
        "search_space_patch": {},
        "evaluation_contract_patch": {},
        "structure_patch": {},
        "global_config_patch": {},
        "node_param_patches": [],
    }
    runtime_patch["search_space_patch"] = dict(runtime_patch.get("search_space_patch") or {})
    runtime_patch["search_space_patch"].update(dict(proposal.get("search_space_patch") or {}))
    runtime_patch["evaluation_contract_patch"] = dict(runtime_patch.get("evaluation_contract_patch") or {})
    runtime_patch["evaluation_contract_patch"].update(dict(proposal.get("evaluation_contract_patch") or {}))
    runtime_patch["structure_patch"] = _merge_structure_patch_bundle(
        dict(runtime_patch.get("structure_patch") or {}),
        dict(proposal.get("structure_patch") or {}),
    )
    runtime_patch["global_config_patch"] = _merge_global_config_patch_bundle(
        dict(runtime_patch.get("global_config_patch") or {}),
        dict(proposal.get("global_config_patch") or {}),
    )
    runtime_patch["node_param_patches"] = _merge_node_param_patches_bundle(
        runtime_patch.get("node_param_patches"),
        proposal.get("node_param_patches"),
    )
    fr_apply = proposal.get("feature_recipe_id")
    if isinstance(fr_apply, str) and fr_apply.strip():
        runtime_patch["feature_recipe_id"] = fr_apply.strip()
    state["runtime_patch"] = runtime_patch
    state["latest_applied_proposal_id"] = proposal_id
    # 任务 26.3：apply 后记录 last_applied_proposal_id 供假设验证使用
    state["last_applied_proposal_id"] = proposal_id
    # 日志打印：确认三个字段都写入
    import logging as _logging
    _n_switches = len((runtime_patch.get("structure_patch") or {}).get("node_switches") or [])
    _n_npp = len(runtime_patch.get("node_param_patches") or [])
