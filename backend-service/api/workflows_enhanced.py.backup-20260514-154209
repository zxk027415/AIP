            artifact_paths: List[str] = []
            artifact_urls: List[str] = []
            if generate_artifacts:
                try:
                    artifact_paths = await asyncio.to_thread(
                        _save_backtest_artifacts, result.get("daily_results", []), output_dir
                    )
