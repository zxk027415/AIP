@router.post("", response_model=EnhancedWorkflow, summary="保存算法模板")
async def save_workflow(workflow_data: dict):
    """
    保存新的算法模板
    
    Args:
        workflow_data: 算法模板数据
        
    Returns:
        EnhancedWorkflow: 保存后的算法模板（包含ID和时间戳）
    """
    try:
        print(f"\n{'='*60}")
        print("收到保存算法模板请求")
